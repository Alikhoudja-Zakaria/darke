rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is the super administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() in ['alikhoudjazakariia@gmail.com', 'alikoudjazakariia@gmail.com'];
    }

    // Public listings collection
    match /listings/{listingId} {
      // Anyone can browse listings
      allow read: if true;
      
      // Logged in users can create listings
      allow create: if request.auth != null;
      
      // Author OR Super Admin can edit or delete
      allow update, delete: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User profiles collection
    match /users/{userId} {
      // Users can view their own profile or public author profiles, admin can view all
      allow read: if request.auth != null;
      
      // Users can edit their own profile, admin can update (e.g. suspend/activate)
      allow create, update: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
        
      allow delete: if isAdmin();
    }

    // Reports and moderation collection
    match /reports/{reportId} {
      // Anyone (users or visitors) can submit a report or takedown request
      allow create: if true;
      // Only Super Admin can read, resolve, or delete reports
      allow read, update, delete: if isAdmin();
    }

    // Support tickets collection from contact form
    match /support_tickets/{ticketId} {
      // Anyone can submit a ticket
      allow create: if true;
      // Only Super Admin can read, update, or delete tickets
      allow read, update, delete: if isAdmin();
    }
  }
}
